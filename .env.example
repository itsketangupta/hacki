# ===================================================================
# Hacki — The Hack Club AI Assistant Configuration (.env.example)
# ===================================================================

# Server Port
PORT=3000

# Hack Club AI Configuration (ai.hackclub.com)
AI_API_KEY=sk-hc-v1-your-ai-hackclub-key
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_MODEL=openai/gpt-4o-mini

# Slack Bot Integration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_NEWS_CHANNEL=
SLACK_HACKI_CHANNEL=hacki

# Slack Sync Options
ENABLE_SLACK_BOT=true
ENABLE_SLACK_SYNC=true
SLACK_SYNC_INTERVAL_MS=300000

NEWS_KEYWORDS=reviewer,review,fulfil,fulfill,fulfillment,hiring,recruiting,opportunity,volunteer,deadline,launch,ysws,bounty,grant,stipend

# Hack Club Auth OAuth (auth.hackclub.com)
HACKCLUB_CLIENT_ID=your-client-id
HACKCLUB_CLIENT_SECRET=your-client-secret
HACKCLUB_REDIRECT_URI=http://localhost:3000/auth/callback
PUBLIC_BASE_URL=http://localhost:3000
