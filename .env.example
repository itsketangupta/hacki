# ===================================================================
# Hacki — The Hack Club AI Assistant Configuration (.env.example)
# ===================================================================

# Server Port
PORT=3000

# Hack Club AI Configuration (ai.hackclub.com)
AI_API_KEY=sk-hc-v1-your-ai-hackclub-key
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
AI_MODEL=openai/gpt-4o-mini
# Optional OpenAI-compatible fallback, used if the primary provider errors
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_FALLBACK_MODEL=gemini-2.5-flash

# Encryption key for per-user model keys and MCP bearer tokens in Slack App Home (32 random bytes, base64)
# Generate with: openssl rand -base64 32
# SLACK_USER_SECRETS_ENCRYPTION_KEY=
# Legacy alias for SLACK_USER_SECRETS_ENCRYPTION_KEY:
# SLACK_MODEL_KEYS_ENCRYPTION_KEY=

# Optional live web search (Exa)
# EXA_API_KEY=

# Optional remotely hosted headful Chromium over Chrome DevTools Protocol.
# The browser service receives requested URLs and returns rendered page text.
# BROWSER_CDP_URL=wss://your-browser-service.example/connect?token=...

# Optional confirmed GitHub file edits. Use a fine-grained token limited to approved repos with Contents: read/write.
# Both allowlists are required; Slack user IDs can be copied from Slack profile > Copy member ID.
# GITHUB_TOKEN=
# GITHUB_ALLOWED_OWNERS=your-github-user-or-org
# GITHUB_ALLOWED_SLACK_USERS=U0123456789
# GITHUB_COMMITTER_NAME=Hacki
# GITHUB_COMMITTER_EMAIL=hacki@example.com


# Optional isolated, persistent per-thread code execution
# E2B_API_KEY=

# Optional email sender; Gmail requires 2-Step Verification and an app password.
# Keep the app password only in the Nest .env file, never in source control.
# SMTP_URL=smtps://you%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:465
# MAIL_FROM=Your Name <you@gmail.com>

# Slack Bot Integration & Auto-Invite
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_NEWS_CHANNEL=C0C8T8Q8R9P
SLACK_HACKI_CHANNEL=hacki

# Slack Sync Options
ENABLE_SLACK_BOT=true
ENABLE_SLACK_SYNC=true
SLACK_SYNC_INTERVAL_MS=300000

NEWS_KEYWORDS=reviewer,review,fulfil,fulfill,fulfillment,hiring,recruiting,opportunity,volunteer,deadline,launch,ysws,bounty,grant,stipend

# Hack Club Auth OAuth (auth.hackclub.com)
HACKCLUB_CLIENT_ID=your-client-id
HACKCLUB_CLIENT_SECRET=your-client-secret
HACKCLUB_REDIRECT_URI=http://localhost:3000/auth/callback
PUBLIC_BASE_URL=http://localhost:3000
