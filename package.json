{
  "name": "hacki",
  "version": "1.0.0",
  "description": "Hacki — The Hack Club AI Assistant for Team, YSWS, and Slack Opportunities",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node src/index.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/index.js",
    "dev:client": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "sync": "node src/scripts/sync-data.js"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.9.0",
    "@slack/bolt": "^4.2.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "nodemailer": "^10.1.7",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
